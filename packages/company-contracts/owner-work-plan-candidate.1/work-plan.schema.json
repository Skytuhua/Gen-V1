{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:owner-work-plan:1.0.0-candidate.1",
  "title": "Owner work-plan to existing WorkOrder candidate",
  "description": "Structural schemas only. Supplemental UTF-8 byte, digest, scope, equality, current basis, policy and authority checks are mandatory. All execution flags remain false.",
  "$defs": {
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {
        "const": "company-ops"
      }
    },
    "Principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "PilotEmployee": {
      "enum": [
        "E01",
        "E10",
        "E11"
      ]
    },
    "Employee": {
      "type": "string",
      "pattern": "^E(?:0[1-9]|[12][0-9]|3[0-2])$"
    },
    "ProjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "project"
        },
        "id": {
          "$ref": "#/$defs/ProjectId"
        }
      }
    },
    "PlanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "project_id",
        "revision",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "work_plan"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "employee_id",
        "instruction",
        "depends_on",
        "expected_artifact_types",
        "acceptance_checks"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "employee_id": {
          "$ref": "#/$defs/PilotEmployee"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        },
        "expected_artifact_types": {
          "type": "array",
          "items": {
            "enum": [
              "code",
              "report",
              "test_evidence"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "acceptance_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "LogicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "RepositoryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "paths"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogicalPath"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      }
    },
    "PlanBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "employee_ids",
        "budget_cents",
        "steps",
        "repository_inputs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "employee_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PilotEmployee"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "budget_cents": {
          "$ref": "#/$defs/SafeInteger"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "repository_inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryInput"
          },
          "minItems": 0,
          "maxItems": 8
        }
      }
    },
    "LegacyInstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "instruction",
        "kind",
        "state",
        "planner",
        "model_produced",
        "dispatch_authorized",
        "live_ready",
        "evidence_scope",
        "blockers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "kind": {
          "const": "planning_proposal"
        },
        "state": {
          "const": "planning_only"
        },
        "planner": {
          "const": "capability_missing"
        },
        "model_produced": {
          "const": false
        },
        "dispatch_authorized": {
          "const": false
        },
        "live_ready": {
          "const": false
        },
        "evidence_scope": {
          "const": "local_owner_instruction"
        },
        "blockers": {
          "type": "array",
          "prefixItems": [
            {
              "const": "native_ordinary_chat_planner_absent"
            },
            {
              "const": "native_dispatch_unavailable"
            },
            {
              "const": "exact_existing_approvals_remain_required"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "InstructionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "digest",
        "record"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "record": {
          "$ref": "#/$defs/LegacyInstruction"
        }
      }
    },
    "CharterSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "purpose",
        "manager",
        "repositories",
        "permitted_paths",
        "state",
        "acceptance_checks",
        "priority",
        "budget_cents"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ProjectId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "manager": {
          "$ref": "#/$defs/Employee"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "permitted_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "state": {
          "const": "proposed"
        },
        "acceptance_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "priority": {
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "budget_cents": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "CharterBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "spec"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "spec": {
          "$ref": "#/$defs/CharterSpec"
        }
      }
    },
    "StaffingBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employee_id",
        "responsibility",
        "approval_id",
        "approval_digest",
        "expires_at_epoch_seconds"
      ],
      "properties": {
        "employee_id": {
          "$ref": "#/$defs/PilotEmployee"
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_digest": {
          "$ref": "#/$defs/Digest"
        },
        "expires_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "Basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "charter",
        "staffing",
        "policy_version"
      ],
      "properties": {
        "instruction": {
          "$ref": "#/$defs/InstructionBasis"
        },
        "charter": {
          "$ref": "#/$defs/CharterBasis"
        },
        "staffing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StaffingBasis"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "policy_version": {
          "const": 1
        }
      }
    },
    "PlanRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "id",
        "company_id",
        "project_id",
        "instruction_id",
        "revision",
        "previous_digest",
        "owner_principal",
        "recorded_at_epoch_seconds",
        "origin",
        "basis",
        "plan",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "work_plan"
        },
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "company_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "instruction_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "previous_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_principal": {
          "$ref": "#/$defs/Principal"
        },
        "recorded_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        },
        "origin": {
          "const": "owner_forwarded_unverified_plan"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "plan": {
          "$ref": "#/$defs/PlanBody"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ProposeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "message_id",
        "instruction_id",
        "expected_head_ref",
        "plan"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "message_id": {
          "$ref": "#/$defs/Identifier"
        },
        "instruction_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expected_head_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "$ref": "#/$defs/PlanBody"
        }
      }
    },
    "ReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "instruction_id",
        "plan_ref"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "instruction_id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanRef"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AuthorizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "message_id",
        "plan_ref",
        "expires_at_epoch_seconds"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "message_id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "expires_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "ProposalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "action",
        "company_id",
        "project_id",
        "principal_id",
        "command_id",
        "request_digest",
        "plan_ref",
        "accepted_at_epoch_seconds",
        "work_order_stored",
        "work_order_id",
        "work_order_digest",
        "task_materialization",
        "dispatch_authorized",
        "live_ready",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "work_plan_receipt"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "action": {
          "const": "work_plan.propose"
        },
        "company_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "principal_id": {
          "$ref": "#/$defs/Principal"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "plan_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "accepted_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        },
        "work_order_stored": {
          "const": false
        },
        "work_order_id": {
          "const": null
        },
        "work_order_digest": {
          "const": null
        },
        "task_materialization": {
          "const": false
        },
        "dispatch_authorized": {
          "const": false
        },
        "live_ready": {
          "const": false
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "AuthorizationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "action",
        "company_id",
        "project_id",
        "principal_id",
        "command_id",
        "request_digest",
        "plan_ref",
        "accepted_at_epoch_seconds",
        "work_order_stored",
        "work_order_id",
        "work_order_digest",
        "task_materialization",
        "dispatch_authorized",
        "live_ready",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "work_plan_receipt"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "action": {
          "const": "work_plan.authorize"
        },
        "company_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "principal_id": {
          "$ref": "#/$defs/Principal"
        },
        "command_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "plan_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "accepted_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        },
        "work_order_stored": {
          "const": true
        },
        "work_order_id": {
          "$ref": "#/$defs/Identifier"
        },
        "work_order_digest": {
          "$ref": "#/$defs/Digest"
        },
        "task_materialization": {
          "const": false
        },
        "dispatch_authorized": {
          "const": false
        },
        "live_ready": {
          "const": false
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "WorkOrderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_order_id",
        "scope",
        "employee_ids",
        "budget_cents"
      ],
      "properties": {
        "work_order_id": {
          "$ref": "#/$defs/Identifier"
        },
        "scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "employee_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PilotEmployee"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "budget_cents": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "OwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "action",
        "scope",
        "audit_ref",
        "expires_at",
        "policy_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "actor": {
          "const": "Skytuhua"
        },
        "action": {
          "const": "create_work_order"
        },
        "scope": {
          "$ref": "#/$defs/WorkOrderRecord"
        },
        "audit_ref": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "$ref": "#/$defs/SafeInteger"
        },
        "policy_version": {
          "const": 1
        }
      }
    },
    "WorkOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record",
        "digest",
        "approval_id",
        "expires_at_epoch_seconds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "record": {
          "$ref": "#/$defs/WorkOrderRecord"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "approval_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expires_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "Authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "id",
        "company_id",
        "project_id",
        "instruction_id",
        "plan_ref",
        "owner_principal",
        "request",
        "request_digest",
        "expires_at_epoch_seconds",
        "recorded_at_epoch_seconds",
        "policy_version",
        "owner_approval",
        "work_order",
        "task_materialization",
        "dispatch_authorized",
        "live_ready",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "work_plan_authorization"
        },
        "schema_version": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "company_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "instruction_id": {
          "$ref": "#/$defs/Identifier"
        },
        "plan_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "owner_principal": {
          "$ref": "#/$defs/Principal"
        },
        "request": {
          "$ref": "#/$defs/AuthorizeRequest"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "expires_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        },
        "recorded_at_epoch_seconds": {
          "$ref": "#/$defs/SafeInteger"
        },
        "policy_version": {
          "const": 1
        },
        "owner_approval": {
          "$ref": "#/$defs/OwnerApproval"
        },
        "work_order": {
          "$ref": "#/$defs/WorkOrder"
        },
        "task_materialization": {
          "const": false
        },
        "dispatch_authorized": {
          "const": false
        },
        "live_ready": {
          "const": false
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ProposeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan",
        "receipt"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/PlanRecord"
        },
        "receipt": {
          "$ref": "#/$defs/ProposalReceipt"
        }
      }
    },
    "AuthorizeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authorization",
        "receipt"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "authorization": {
          "$ref": "#/$defs/Authorization"
        },
        "receipt": {
          "$ref": "#/$defs/AuthorizationReceipt"
        }
      }
    },
    "Eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_current",
        "basis_current",
        "can_authorize",
        "authorization_current",
        "blockers",
        "task_materialization",
        "dispatch_authorized",
        "live_ready",
        "execution_blockers"
      ],
      "properties": {
        "is_current": {
          "type": "boolean"
        },
        "basis_current": {
          "type": "boolean"
        },
        "can_authorize": {
          "type": "boolean"
        },
        "authorization_current": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "enum": [
              "stale_plan",
              "stale_basis",
              "prerequisite_unavailable",
              "authorization_permission_missing",
              "authorization_expired",
              "already_authorized"
            ]
          },
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "task_materialization": {
          "const": false
        },
        "dispatch_authorized": {
          "const": false
        },
        "live_ready": {
          "const": false
        },
        "execution_blockers": {
          "type": "array",
          "prefixItems": [
            {
              "const": "protected_runtime_authentication_unavailable"
            },
            {
              "const": "effective_model_and_accounting_unavailable"
            },
            {
              "const": "trusted_live_admission_and_dispatch_unavailable"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "ReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan",
        "current_head_ref",
        "eligibility",
        "authorization"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/PlanRecord"
        },
        "current_head_ref": {
          "$ref": "#/$defs/PlanRef"
        },
        "eligibility": {
          "$ref": "#/$defs/Eligibility"
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthorizeResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "authentication_required",
                "scope_denied",
                "not_found",
                "stale_plan",
                "stale_basis",
                "command_conflict",
                "already_authorized",
                "authorization_expired",
                "scoped_replanning_unavailable",
                "prerequisite_unavailable",
                "request_timeout",
                "request_too_large",
                "unsupported_media_type"
              ]
            }
          }
        }
      }
    }
  }
}
