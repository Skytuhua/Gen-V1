{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:communications:owner-discussion-thread-candidate.1",
  "$comment": "Additive implemented bounded owner-room query. Apply strict output262144 rawUTF8 boundary, existing record checks and supplemental manifest bindings; structural schema alone insufficient. No frozen MessagePage change.",
  "oneOf": [
    {
      "$ref": "#/$defs/ThreadPage"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "ThreadPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "projection_type": {
          "const": "owner_discussion_thread"
        },
        "company_id": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/CompanyId"
        },
        "scope": {
          "allOf": [
            {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/TaskScope"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "project"
                }
              }
            }
          ]
        },
        "room_head": {
          "anyOf": [
            {
              "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Conversation"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/ReadBack"
          }
        },
        "requested_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "order": {
          "const": "conversation_sequence_descending"
        },
        "observed_at_utc_epoch_ms": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/UtcEpochMilliseconds"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "partial"
            },
            "truncation": {
              "enum": [
                "none_observed",
                "item_limit",
                "byte_limit"
              ]
            },
            "total_count": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "truncation",
            "total_count"
          ]
        },
        "has_more": {
          "type": "null"
        },
        "next_cursor": {
          "type": "null"
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "cursor_protocol_unimplemented"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "snapshot_protocol_unimplemented"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "const": 50
            },
            "max_response_utf8_bytes": {
              "const": 262144
            }
          },
          "required": [
            "max_items",
            "max_response_utf8_bytes"
          ]
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "stored_record"
            },
            "evidence_scope": {
              "const": "stored_record"
            },
            "live_verified": {
              "const": false
            }
          },
          "required": [
            "source",
            "evidence_scope",
            "live_verified"
          ]
        },
        "digest": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "projection_type",
        "company_id",
        "scope",
        "room_head",
        "items",
        "requested_limit",
        "order",
        "observed_at_utc_epoch_ms",
        "coverage",
        "has_more",
        "next_cursor",
        "continuation",
        "snapshot",
        "limits",
        "observation",
        "digest"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "AUTHENTICATION_REQUIRED",
                "SCOPE_DENIED",
                "NOT_FOUND",
                "RECORDS_UNAVAILABLE"
              ]
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ]
    }
  }
}
