{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:communications:v1:strict-json-value",
  "$ref": "#/$defs/value",
  "$comment": "Lexical integer-only/-0, strict UTF-8, decoded duplicate keys, unpaired surrogates, depth<=64 and raw<=32768 byte checks require the codec before schema validation. Keys sort explicitly by UTF-16 code units.",
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
