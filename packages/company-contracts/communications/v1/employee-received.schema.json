{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:communications:v1:employee-received",
  "$comment": "Additive received-only stage. Strict frozen C01 raw checks and supplemental scope/identity/ref/digest bindings required; data is not authentication or disk attestation.",
  "oneOf": [
    {
      "$ref": "#/$defs/Command"
    },
    {
      "$ref": "#/$defs/LocalReceipt"
    },
    {
      "$ref": "#/$defs/Receipt"
    }
  ],
  "$defs": {
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "command_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Uuid"
        },
        "action": {
          "const": "delivery.ack"
        },
        "scope": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/ProjectScope"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stage": {
              "const": "received"
            },
            "delivery_ref": {
              "$ref": "urn:maritime:communications:v1:employee-information#/$defs/DeliveryRef"
            },
            "local_receipt": {
              "$ref": "#/$defs/LocalReceipt"
            }
          },
          "required": [
            "stage",
            "delivery_ref",
            "local_receipt"
          ]
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "action",
        "scope",
        "payload"
      ]
    },
    "LocalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "local_receive_receipt"
        },
        "id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Uuid"
        },
        "company_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/ProjectScope"
        },
        "delivery_ref": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/DeliveryRef"
        },
        "message_ref": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/MessageRef"
        },
        "recipient": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Actor"
        },
        "machine_principal_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/OpaqueExistingId"
        },
        "journal_owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "envelope_digest": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Digest"
        },
        "stored_at_utc_epoch_ms": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/UtcEpochMilliseconds"
        },
        "stage": {
          "const": "received"
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "supervisor_journal"
            },
            "evidence_scope": {
              "const": "synthetic_only"
            },
            "live_verified": {
              "const": false
            }
          },
          "required": [
            "source",
            "evidence_scope",
            "live_verified"
          ]
        },
        "digest": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "id",
        "company_id",
        "scope",
        "delivery_ref",
        "message_ref",
        "recipient",
        "machine_principal_id",
        "journal_owner_id",
        "envelope_digest",
        "stored_at_utc_epoch_ms",
        "stage",
        "observation",
        "digest"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_type": {
          "const": "delivery_receipt"
        },
        "id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Uuid"
        },
        "revision": {
          "const": 1
        },
        "company_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/ProjectScope"
        },
        "principal_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/OpaqueExistingId"
        },
        "command_id": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Uuid"
        },
        "action": {
          "const": "delivery.ack"
        },
        "argument_digest": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Digest"
        },
        "stage": {
          "const": "received"
        },
        "delivery_ref": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/DeliveryRef"
        },
        "message_ref": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/MessageRef"
        },
        "recipient": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Actor"
        },
        "local_receipt": {
          "$ref": "#/$defs/LocalReceipt"
        },
        "received_at_utc_epoch_ms": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/UtcEpochMilliseconds"
        },
        "observation": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Observation"
        },
        "digest": {
          "$ref": "urn:maritime:communications:v1:employee-information#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "id",
        "revision",
        "company_id",
        "scope",
        "principal_id",
        "command_id",
        "action",
        "argument_digest",
        "stage",
        "delivery_ref",
        "message_ref",
        "recipient",
        "local_receipt",
        "received_at_utc_epoch_ms",
        "observation",
        "digest"
      ]
    }
  }
}
