{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:communications:owner-discussion-history-candidate.1",
  "$comment": "Additive immutable-cut history only. Apply supplemental cross-page/ref/digest/raw-byte checks; no frozen first-page or full C07 schema change.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/HistoryPage"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "not": {
            "const": "company-ops"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id",
        "limit",
        "cursor"
      ]
    },
    "HistoryPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "projection_type": {
          "const": "owner_discussion_history"
        },
        "company_id": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/CompanyId"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "not": {
                "const": "company-ops"
              }
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "watermark_head": {
          "anyOf": [
            {
              "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Conversation"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/ReadBack"
          }
        },
        "requested_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "order": {
          "const": "conversation_sequence_descending"
        },
        "observed_at_utc_epoch_ms": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/UtcEpochMilliseconds"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "append_only_room_cut"
            },
            "id": {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Uuid"
            },
            "incarnation": {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Uuid"
            },
            "access_digest": {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Digest"
            },
            "issued_at_utc_epoch_ms": {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/UtcEpochMilliseconds"
            },
            "expires_at_utc_epoch_ms": {
              "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/UtcEpochMilliseconds"
            },
            "watermark_message_ref": {
              "anyOf": [
                {
                  "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Receipt/properties/message_ref"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "incarnation",
            "access_digest",
            "issued_at_utc_epoch_ms",
            "expires_at_utc_epoch_ms",
            "watermark_message_ref"
          ]
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_sequence": {
              "anyOf": [
                {
                  "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_sequence": {
              "anyOf": [
                {
                  "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_sequence": {
              "anyOf": [
                {
                  "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "start_sequence",
            "end_sequence",
            "next_sequence"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "partial",
                "complete_for_cut"
              ]
            },
            "truncation": {
              "enum": [
                "none",
                "item_limit",
                "byte_limit"
              ]
            },
            "total_count": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "truncation",
            "total_count"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_items": {
              "const": 50
            },
            "max_response_utf8_bytes": {
              "const": 262144
            },
            "max_cursor_chars": {
              "const": 4096
            }
          },
          "required": [
            "max_items",
            "max_response_utf8_bytes",
            "max_cursor_chars"
          ]
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "stored_record"
            },
            "evidence_scope": {
              "const": "stored_record"
            },
            "live_verified": {
              "const": false
            }
          },
          "required": [
            "source",
            "evidence_scope",
            "live_verified"
          ]
        },
        "digest": {
          "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Digest"
        }
      },
      "required": [
        "schema_version",
        "projection_type",
        "company_id",
        "scope",
        "watermark_head",
        "items",
        "requested_limit",
        "order",
        "observed_at_utc_epoch_ms",
        "snapshot",
        "range",
        "has_more",
        "next_cursor",
        "coverage",
        "limits",
        "observation",
        "digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "range": {
                "type": "object",
                "properties": {
                  "next_sequence": {
                    "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                  }
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "partial"
                  },
                  "truncation": {
                    "enum": [
                      "item_limit",
                      "byte_limit"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "null"
              },
              "range": {
                "type": "object",
                "properties": {
                  "next_sequence": {
                    "type": "null"
                  }
                }
              },
              "coverage": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "complete_for_cut"
                  },
                  "truncation": {
                    "const": "none"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "watermark_head": {
                "type": "null"
              }
            },
            "required": [
              "watermark_head"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 0
              },
              "has_more": {
                "const": false
              },
              "range": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "start_sequence": {
                    "type": "null"
                  },
                  "end_sequence": {
                    "type": "null"
                  },
                  "next_sequence": {
                    "type": "null"
                  }
                },
                "required": [
                  "start_sequence",
                  "end_sequence",
                  "next_sequence"
                ]
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "watermark_message_ref": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1
              },
              "range": {
                "type": "object",
                "properties": {
                  "start_sequence": {
                    "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                  },
                  "end_sequence": {
                    "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Revision"
                  }
                }
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "watermark_message_ref": {
                    "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Receipt/properties/message_ref"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "AUTHENTICATION_REQUIRED",
                "SCOPE_DENIED",
                "NOT_FOUND",
                "RESYNC_REQUIRED",
                "RECORDS_UNAVAILABLE"
              ]
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ]
    }
  }
}
