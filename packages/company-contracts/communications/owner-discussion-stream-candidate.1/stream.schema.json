{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maritime:communications:owner-discussion-stream-candidate.1",
  "$comment": "Additive future-only public accepted-message pull replay. Structural validation is insufficient: enforce raw bytes, canonical digests, exact retained scope/query/snapshot, per-item bounds, coverage/ranges and cross-page identity/continuity. No SSE, command execution, default grant, remote owner session or full C07.",
  "oneOf": [
    {
      "$ref": "#/$defs/SnapshotRequest"
    },
    {
      "$ref": "#/$defs/ChangesRequest"
    },
    {
      "$ref": "#/$defs/SnapshotPage"
    },
    {
      "$ref": "#/$defs/EventPage"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "ProjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "not": {
        "const": "company-ops"
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "project"
        },
        "id": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "CompanyId": {
      "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/CompanyId"
    },
    "Uuid": {
      "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Uuid"
    },
    "UuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Digest": {
      "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/Digest"
    },
    "Time": {
      "$ref": "urn:maritime:communications:reads-candidate.1#/$defs/UtcEpochMilliseconds"
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "stored_record"
        },
        "evidence_scope": {
          "const": "stored_record"
        },
        "live_verified": {
          "const": false
        }
      },
      "required": [
        "source",
        "evidence_scope",
        "live_verified"
      ]
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "ConversationRef": {
      "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Receipt/properties/conversation_ref"
    },
    "MessageRef": {
      "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Receipt/properties/message_ref"
    },
    "Record": {
      "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/ReadBack"
    },
    "EventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "communication_event"
        },
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "company_id": {
          "$ref": "#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "availability": {
          "const": "available"
        },
        "revision": {
          "const": 1
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "unavailable_reason": {
          "const": null
        }
      },
      "required": [
        "kind",
        "id",
        "company_id",
        "scope",
        "availability",
        "revision",
        "digest",
        "unavailable_reason"
      ]
    },
    "CoverageFloor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conversation_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "message_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sequence",
        "conversation_ref",
        "message_ref"
      ]
    },
    "Watermark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conversation_ref": {
          "$ref": "#/$defs/ConversationRef"
        },
        "message_ref": {
          "$ref": "#/$defs/MessageRef"
        },
        "event_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "position",
        "conversation_ref",
        "message_ref",
        "event_ref"
      ]
    },
    "Limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_items": {
          "const": 50
        },
        "max_event_utf8_bytes": {
          "const": 65536
        },
        "max_response_utf8_bytes": {
          "const": 262144
        },
        "max_cursor_chars": {
          "const": 4096
        }
      },
      "required": [
        "max_items",
        "max_event_utf8_bytes",
        "max_response_utf8_bytes",
        "max_cursor_chars"
      ]
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "owner_discussion_public_cut"
        },
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "incarnation": {
          "$ref": "#/$defs/Uuid"
        },
        "visibility_revision": {
          "const": 1
        },
        "access_digest": {
          "$ref": "#/$defs/Digest"
        },
        "stream_epoch": {
          "$ref": "#/$defs/UuidV4"
        },
        "issued_at_utc_epoch_ms": {
          "$ref": "#/$defs/Time"
        },
        "expires_at_utc_epoch_ms": {
          "$ref": "#/$defs/Time"
        },
        "coverage_floor": {
          "$ref": "#/$defs/CoverageFloor"
        },
        "watermark": {
          "$ref": "#/$defs/Watermark"
        }
      },
      "required": [
        "kind",
        "id",
        "incarnation",
        "visibility_revision",
        "access_digest",
        "stream_epoch",
        "issued_at_utc_epoch_ms",
        "expires_at_utc_epoch_ms",
        "coverage_floor",
        "watermark"
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_type": {
          "const": "communication_event"
        },
        "id": {
          "$ref": "#/$defs/UuidV4"
        },
        "schema_version": {
          "const": 1
        },
        "revision": {
          "const": 1
        },
        "visibility_revision": {
          "const": 1
        },
        "company_id": {
          "$ref": "#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "event_type": {
          "const": "owner_discussion.message_stored"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "company_service"
            },
            "component": {
              "const": "owner_discussion_acceptance"
            },
            "version": {
              "const": 1
            }
          },
          "required": [
            "kind",
            "component",
            "version"
          ]
        },
        "stream_epoch": {
          "$ref": "#/$defs/UuidV4"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "conversation_ref": {
          "$ref": "#/$defs/ConversationRef"
        },
        "message_ref": {
          "$ref": "#/$defs/MessageRef"
        },
        "accepted_command": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "owner.discussion.append"
            },
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\u0000]+$"
            },
            "command_id": {
              "$ref": "#/$defs/Uuid"
            },
            "request_digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "action",
            "principal_id",
            "command_id",
            "request_digest"
          ]
        },
        "recorded_at_utc_epoch_ms": {
          "$ref": "#/$defs/Time"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "record_type",
        "id",
        "schema_version",
        "revision",
        "visibility_revision",
        "company_id",
        "scope",
        "event_type",
        "producer",
        "stream_epoch",
        "sequence",
        "conversation_ref",
        "message_ref",
        "accepted_command",
        "recorded_at_utc_epoch_ms",
        "observation",
        "digest"
      ]
    },
    "EventItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "record": {
          "$ref": "#/$defs/Record"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "event",
        "record",
        "digest"
      ]
    },
    "SnapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "snapshot"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "limit": {
          "$ref": "#/$defs/Limit"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "project_id",
        "limit",
        "cursor"
      ]
    },
    "ChangesRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "changes"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "limit": {
          "$ref": "#/$defs/Limit"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      },
      "required": [
        "operation",
        "project_id",
        "limit",
        "cursor"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "AUTHENTICATION_REQUIRED",
                "SCOPE_DENIED",
                "NOT_FOUND",
                "RESYNC_REQUIRED",
                "RECORDS_UNAVAILABLE"
              ]
            }
          },
          "required": [
            "code"
          ]
        }
      },
      "required": [
        "schema_version",
        "error"
      ]
    },
    "SnapshotPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "company_id": {
          "$ref": "#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "requested_limit": {
          "$ref": "#/$defs/Limit"
        },
        "observed_at_utc_epoch_ms": {
          "$ref": "#/$defs/Time"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "projection_type": {
          "const": "owner_discussion_snapshot"
        },
        "room_head": {
          "$ref": "urn:maritime:communications:owner-discussion-candidate.1#/$defs/Conversation"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Record"
          }
        },
        "order": {
          "const": "conversation_sequence_descending"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "end_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "next_sequence": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "start_sequence",
            "end_sequence",
            "next_sequence"
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "next_snapshot_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "partial",
                "complete_for_cut"
              ]
            },
            "truncation": {
              "enum": [
                "none",
                "item_limit",
                "byte_limit"
              ]
            },
            "total_count": {
              "const": null
            }
          },
          "required": [
            "status",
            "truncation",
            "total_count"
          ]
        }
      },
      "required": [
        "schema_version",
        "company_id",
        "scope",
        "requested_limit",
        "observed_at_utc_epoch_ms",
        "snapshot",
        "limits",
        "observation",
        "digest",
        "projection_type",
        "room_head",
        "items",
        "order",
        "range",
        "has_more",
        "next_snapshot_cursor",
        "changes_cursor",
        "coverage"
      ]
    },
    "EventPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "company_id": {
          "$ref": "#/$defs/CompanyId"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "requested_limit": {
          "$ref": "#/$defs/Limit"
        },
        "observed_at_utc_epoch_ms": {
          "$ref": "#/$defs/Time"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "projection_type": {
          "const": "owner_discussion_changes"
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/EventItem"
          }
        },
        "order": {
          "const": "public_event_sequence_ascending"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "start_position": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "observed_through_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "after_position",
            "start_position",
            "end_position",
            "observed_through_position"
          ]
        },
        "caught_up": {
          "type": "boolean"
        },
        "next_cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "caught_up_through_observed",
                "partial"
              ]
            },
            "truncation": {
              "enum": [
                "none",
                "item_limit",
                "byte_limit"
              ]
            },
            "total_count": {
              "const": null
            }
          },
          "required": [
            "status",
            "truncation",
            "total_count"
          ]
        }
      },
      "required": [
        "schema_version",
        "company_id",
        "scope",
        "requested_limit",
        "observed_at_utc_epoch_ms",
        "snapshot",
        "limits",
        "observation",
        "digest",
        "projection_type",
        "items",
        "order",
        "range",
        "caught_up",
        "next_cursor",
        "coverage"
      ]
    }
  }
}
