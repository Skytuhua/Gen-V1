{
  "name": "generative-harness",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/server/main.ts",
    "build": "pnpm build:widgets && vite build",
    "build:widgets": "node scripts/build-widgets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:widgets && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "agent:login": "tsx packages/runtime-login/index.ts",
    "fixtures:create": "tsx scripts/create-fixtures.ts",
    "eval": "tsx evals/runner.ts",
    "desktop:dev": "pnpm build && pnpm desktop:build && tsx scripts/run-desktop.ts",
    "desktop:build": "tsx scripts/build-desktop.ts",
    "desktop:package": "pnpm build && pnpm desktop:build && tsx scripts/package-desktop.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@cursor/sdk": "1.0.38",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@google/gemini-cli": "0.66.0",
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@remote-dom/polyfill": "1.6.0",
    "@sinclair/typebox": "0.34.41",
    "ajv": "8.18.0",
    "fastify": "5.12.7",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "4.20.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "undici@8.10.2": "8.12.2",
      "minimatch@10.2.6": "11.0.1"
    }
  }
}
