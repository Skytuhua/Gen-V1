2026-11-15T20:02:02.9497558Z   $source = $expanded
2026-11-15T20:02:02.9497990Z   if ($tool.name -eq 'gh' -and -not (Test-Path -LiteralPath (Join-Path $source 'bin/gh.exe'))) {
2026-11-15T20:02:02.9498566Z     $source = Join-Path $expanded ('gh_' + $pin.version + '_windows_amd64')
2026-11-15T20:02:02.9498939Z   }
2026-11-15T20:02:02.9499199Z   $prefix = '.harness-tool-bundles/' + $tool.name + '/'
2026-11-15T20:02:02.9499639Z   $destination = Join-Path $PWD ('.harness-tool-bundles/' + $tool.name)
2026-11-15T20:02:02.9500225Z   if (Test-Path -LiteralPath $destination) { throw 'Packaging input destination already exists' }
2026-11-15T20:02:02.9500797Z   New-Item -ItemType Directory -Path $destination | Out-Null
2026-11-15T20:02:02.9501313Z   foreach ($file in @($manifest.files | Where-Object { $_.path.StartsWith($prefix) })) {
2026-11-15T20:02:02.9501805Z     $relative = $file.path.Substring($prefix.Length)
2026-11-15T20:02:02.9502565Z     if ([string]::IsNullOrWhiteSpace($relative) -or $relative -match '(^|/)\.\.?(/|$)|[\\:]|^/|//|/$' -or $file.sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Invalid declared Git payload path' }
2026-11-15T20:02:02.9503330Z     $payloadInput = Join-Path $source $relative
2026-11-15T20:02:02.9503698Z     $payloadOutput = Join-Path $destination $relative
2026-11-15T20:02:02.9504660Z     if ((Get-Item -LiteralPath $payloadInput).Length -ne $file.bytes -or (Get-FileHash -LiteralPath $payloadInput -Algorithm SHA256).Hash.ToLowerInvariant() -ne $file.sha256) { throw 'Declared Git payload checksum mismatch' }
2026-11-15T20:02:02.9506190Z     New-Item -ItemType Directory -Path (Split-Path -Parent $payloadOutput) -Force | Out-Null
2026-11-15T20:02:02.9506782Z     Copy-Item -LiteralPath $payloadInput -Destination $payloadOutput
2026-11-15T20:02:02.9507156Z   }
2026-11-15T20:02:02.9507324Z }
