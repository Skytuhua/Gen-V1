2026-11-15T20:02:02.9488849Z $ErrorActionPreference = 'Stop'
2026-11-15T20:02:02.9489387Z $manifest = Get-Content -Raw -LiteralPath third-party/git-tools/manifest.json | ConvertFrom-Json
2026-11-15T20:02:02.9490116Z $scratch = Join-Path $env:RUNNER_TEMP ('gen-installed-inputs-' + [guid]::NewGuid().ToString('N'))
2026-11-15T20:02:02.9490714Z New-Item -ItemType Directory -Path $scratch | Out-Null
2026-11-15T20:02:02.9491262Z foreach ($tool in @(@{name='git'; pin=$manifest.git}, @{name='gh'; pin=$manifest.github})) {
2026-11-15T20:02:02.9492408Z   $pin = $tool.pin
2026-11-15T20:02:02.9493085Z   if ($pin.url -notmatch '^https://github\.com/(git-for-windows/git|cli/cli)/releases/download/[^?#\s]+\.zip$' -or $pin.archiveSha256 -notmatch '^[0-9a-f]{64}$') {
