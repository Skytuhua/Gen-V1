2026-11-15T20:02:02.9494234Z   }
2026-11-15T20:02:02.9494489Z   $archive = Join-Path $scratch ($tool.name + '.zip')
2026-11-15T20:02:02.9494935Z   Invoke-WebRequest -Uri $pin.url -OutFile $archive -TimeoutSec 180
2026-11-15T20:02:02.9495590Z   if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $pin.archiveSha256) {
