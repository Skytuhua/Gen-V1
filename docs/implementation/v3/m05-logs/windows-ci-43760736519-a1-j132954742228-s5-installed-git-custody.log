2026-11-15T20:56:14.4025672Z   $source = $expanded
2026-11-15T20:56:14.4026060Z   if ($tool.name -eq 'gh' -and -not (Test-Path -LiteralPath (Join-Path $source 'bin/gh.exe'))) {
2026-11-15T20:56:14.4026543Z     $source = Join-Path $expanded ('gh_' + $pin.version + '_windows_amd64')
2026-11-15T20:56:14.4026865Z   }
2026-11-15T20:56:14.4027090Z   $prefix = '.harness-tool-bundles/' + $tool.name + '/'
2026-11-15T20:56:14.4027474Z   $destination = Join-Path $PWD ('.harness-tool-bundles/' + $tool.name)
2026-11-15T20:56:14.4027839Z   if (Test-Path -LiteralPath $destination) { throw 'Packaging input destination already exists' }
2026-11-15T20:56:14.4028142Z   New-Item -ItemType Directory -Path $destination | Out-Null
2026-11-15T20:56:14.4028420Z   foreach ($file in @($manifest.files | Where-Object { $_.path.StartsWith($prefix) })) {
2026-11-15T20:56:14.4028685Z     $relative = $file.path.Substring($prefix.Length)
2026-11-15T20:56:14.4029081Z     if ([string]::IsNullOrWhiteSpace($relative) -or $relative -match '(^|/)\.\.?(/|$)|[\\:]|^/|//|/$' -or $file.sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Invalid declared Git payload path' }
2026-11-15T20:56:14.4030022Z     $payloadInput = Join-Path $source $relative
2026-11-15T20:56:14.4030231Z     $payloadOutput = Join-Path $destination $relative
2026-11-15T20:56:14.4030711Z     if ((Get-Item -LiteralPath $payloadInput).Length -ne $file.bytes -or (Get-FileHash -LiteralPath $payloadInput -Algorithm SHA256).Hash.ToLowerInvariant() -ne $file.sha256) { throw 'Declared Git payload checksum mismatch' }
2026-11-15T20:56:14.4031333Z     New-Item -ItemType Directory -Path (Split-Path -Parent $payloadOutput) -Force | Out-Null
2026-11-15T20:56:14.4031688Z     Copy-Item -LiteralPath $payloadInput -Destination $payloadOutput
2026-11-15T20:56:14.4031881Z   }
2026-11-15T20:56:14.4031986Z }
