2026-11-15T20:56:14.4012675Z New-Item -ItemType Directory -Path $scratch | Out-Null
2026-11-15T20:56:14.4012947Z foreach ($tool in @(@{name='git'; pin=$manifest.git}, @{name='gh'; pin=$manifest.github})) {
2026-11-15T20:56:14.4013181Z   $pin = $tool.pin
2026-11-15T20:56:14.4013527Z   if ($pin.url -notmatch '^https://github\.com/(git-for-windows/git|cli/cli)/releases/download/[^?#\s]+\.zip$' -or $pin.archiveSha256 -notmatch '^[0-9a-f]{64}$') {
