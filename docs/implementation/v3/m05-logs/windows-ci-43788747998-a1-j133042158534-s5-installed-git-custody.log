2026-11-16T01:53:20.8554728Z     if ([string]::IsNullOrWhiteSpace($relative) -or $relative -match '(^|/)\.\.?(/|$)|[\\:]|^/|//|/$' -or $file.sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Invalid declared Git payload path' }
2026-11-16T01:53:20.8555881Z     $payloadInput = Join-Path $source $relative
2026-11-16T01:53:20.8556179Z     $payloadOutput = Join-Path $destination $relative
2026-11-16T01:53:20.8556891Z     if ((Get-Item -LiteralPath $payloadInput).Length -ne $file.bytes -or (Get-FileHash -LiteralPath $payloadInput -Algorithm SHA256).Hash.ToLowerInvariant() -ne $file.sha256) { throw 'Declared Git payload checksum mismatch' }
2026-11-16T01:53:20.8557700Z     New-Item -ItemType Directory -Path (Split-Path -Parent $payloadOutput) -Force | Out-Null
2026-11-16T01:53:20.8558129Z     Copy-Item -LiteralPath $payloadInput -Destination $payloadOutput
2026-11-16T01:53:20.8558413Z   }
2026-11-16T01:53:20.8558559Z }
