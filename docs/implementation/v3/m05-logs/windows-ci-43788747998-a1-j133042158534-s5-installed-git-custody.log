2026-11-16T01:53:20.8551629Z   }
2026-11-16T01:53:20.8551844Z   $prefix = '.harness-tool-bundles/' + $tool.name + '/'
2026-11-16T01:53:20.8552191Z   $destination = Join-Path $PWD ('.harness-tool-bundles/' + $tool.name)
2026-11-16T01:53:20.8552636Z   if (Test-Path -LiteralPath $destination) { throw 'Packaging input destination already exists' }
2026-11-16T01:53:20.8553061Z   New-Item -ItemType Directory -Path $destination | Out-Null
2026-11-16T01:53:20.8553449Z   foreach ($file in @($manifest.files | Where-Object { $_.path.StartsWith($prefix) })) {
