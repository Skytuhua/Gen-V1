2026-11-15T16:01:37.8666281Z ##[group]Run $ErrorActionPreference = 'Stop'
2026-11-15T16:01:37.8666842Z $ErrorActionPreference = 'Stop'
2026-11-15T16:01:37.8667459Z $manifest = Get-Content -Raw -LiteralPath third-party/git-tools/manifest.json | ConvertFrom-Json
2026-11-15T16:01:37.8668124Z $scratch = Join-Path $env:RUNNER_TEMP ('gen-installed-inputs-' + [guid]::NewGuid().ToString('N'))
2026-11-15T16:01:37.8668706Z New-Item -ItemType Directory -Path $scratch | Out-Null
2026-11-15T16:01:37.8669244Z foreach ($tool in @(@{name='git'; pin=$manifest.git}, @{name='gh'; pin=$manifest.github})) {
2026-11-15T16:01:37.8669694Z   $pin = $tool.pin
2026-11-15T16:01:37.8670383Z   if ($pin.url -notmatch '^https://github\.com/(git-for-windows/git|cli/cli)/releases/download/[^?#\s]+\.zip$' -or $pin.archiveSha256 -notmatch '^[0-9a-f]{64}$') {
2026-11-15T16:01:37.8671050Z     throw 'Invalid declared Git packaging archive identity'
2026-11-15T16:01:37.8671569Z   }
2026-11-15T16:01:37.8671884Z   $archive = Join-Path $scratch ($tool.name + '.zip')
2026-11-15T16:01:37.8672376Z   Invoke-WebRequest -Uri $pin.url -OutFile $archive -TimeoutSec 180
2026-11-15T16:01:37.8672976Z   if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $pin.archiveSha256) {
2026-11-15T16:01:37.8673614Z     throw 'Declared Git packaging archive checksum mismatch'
2026-11-15T16:01:37.8674005Z   }
2026-11-15T16:01:37.8674311Z   $expanded = Join-Path $scratch $tool.name
2026-11-15T16:01:37.8674766Z   Expand-Archive -LiteralPath $archive -DestinationPath $expanded
2026-11-15T16:01:37.8675382Z   $source = $expanded
2026-11-15T16:01:37.8675874Z   if ($tool.name -eq 'gh' -and -not (Test-Path -LiteralPath (Join-Path $source 'bin/gh.exe'))) {
2026-11-15T16:01:37.8676429Z     $source = Join-Path $expanded ('gh_' + $pin.version + '_windows_amd64')
2026-11-15T16:01:37.8676870Z   }
2026-11-15T16:01:37.8677178Z   $prefix = '.harness-tool-bundles/' + $tool.name + '/'
2026-11-15T16:01:37.8677686Z   $destination = Join-Path $PWD ('.harness-tool-bundles/' + $tool.name)
2026-11-15T16:01:37.8678278Z   if (Test-Path -LiteralPath $destination) { throw 'Packaging input destination already exists' }
2026-11-15T16:01:37.8678835Z   New-Item -ItemType Directory -Path $destination | Out-Null
2026-11-15T16:01:37.8679354Z   foreach ($file in @($manifest.files | Where-Object { $_.path.StartsWith($prefix) })) {
2026-11-15T16:01:37.8680203Z     $relative = $file.path.Substring($prefix.Length)
2026-11-15T16:01:37.8681076Z     if ([string]::IsNullOrWhiteSpace($relative) -or $relative -match '(^|/)\.\.?(/|$)|[\\:]|^/|//|/$' -or $file.sha256 -notmatch '^[0-9a-f]{64}$') { throw 'Invalid declared Git payload path' }
2026-11-15T16:01:37.8681802Z     $payloadInput = Join-Path $source $relative
2026-11-15T16:01:37.8682201Z     $payloadOutput = Join-Path $destination $relative
2026-11-15T16:01:37.8683072Z     if ((Get-Item -LiteralPath $payloadInput).Length -ne $file.bytes -or (Get-FileHash -LiteralPath $payloadInput -Algorithm SHA256).Hash.ToLowerInvariant() -ne $file.sha256) { throw 'Declared Git payload checksum mismatch' }
2026-11-15T16:01:37.8684057Z     New-Item -ItemType Directory -Path (Split-Path -Parent $payloadOutput) -Force | Out-Null
2026-11-15T16:01:37.8684605Z     Copy-Item -LiteralPath $payloadInput -Destination $payloadOutput
2026-11-15T16:01:37.8685049Z   }
2026-11-15T16:01:37.8685297Z }
