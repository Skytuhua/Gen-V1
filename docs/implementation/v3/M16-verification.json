    {
     "id": "m16-c01-grant-contract",
     "status": "PASS",
     "evidence": "InteractiveGrantV1 carries ToolOwner, authenticated device/session identity, exact APPLICATION|BROWSER_TAB target, permitted ops, origins, capture permission, issue/expiry (10 min, no auto-extension) and revocationGeneration; invalid grants reject."
    },
    {
     "id": "m16-c02-action-contract",
     "status": "PASS",
     "evidence": "ControlActionV1 binds actionId, grantId, exact target identity, CAPTURE|CLICK|TYPE|KEYPRESS|UPLOAD|DOWNLOAD|NAVIGATE, redacted parameters, pre/post observation refs and effect receipt; capture is a separate action."
    },
    {
     "id": "m16-c03-capture-contract",
     "status": "PASS",
     "evidence": "CaptureV1 carries artifactId, target, timestamp, frame dimensions, source owner and user-selected scope; no redaction guarantee is declared."
    },
    {
     "id": "m16-d01-default-deny",
     "status": "PASS",
     "evidence": "No approved driver produces DRIVER_UNAVAILABLE before any OS/browser call; a real Service control.request records UNAVAILABLE and liveControlActive false."
    },
    {
     "id": "m16-d02-identity-reuse",
     "status": "PASS",
     "evidence": "A replacement window reusing title/PID has a different creationIdentity; queued input is REJECTED TARGET_MISMATCH and host validation returns NEEDS_NEW_PERMISSION."
    },
    {
     "id": "m16-d03-geometry-binding",
     "status": "PASS",
     "evidence": "Moved or DPI-changed target after queueing rejects the click TARGET_MOVED; no coordinate rescale or silent dispatch."
    },
    {
     "id": "m16-d04-rate-and-queue",
     "status": "PASS",
     "evidence": "Six actions dispatch at 0,200,...,1000ms on a fake monotonic clock; the 17th queued action is QUEUE_FULL without driver work."
    },
    {
     "id": "m16-d05-independent-stop",
     "status": "PASS",
     "evidence": "Stop bumps the generation before queue cancellation; a hung dispatch cannot deliver old-generation input; post-stop enqueue is CANCELLED."
    },
    {
     "id": "consent-lifecycle",
     "status": "PASS",
     "evidence": "requestConsent records UNAVAILABLE while the flag is off; grant requires PENDING consent + flag + exactly one matching driver registration; revocation bumps revocationGeneration; expiry and origin/creation-identity change force renewed consent."
    },
    {
     "id": "capture-interact-separation",
     "status": "PASS",
     "evidence": "CAPTURE requires capturePermission and cannot enter the input queue; unlisted interact ops deny CAPABILITY_DENIED."
    }
