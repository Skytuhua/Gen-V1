+    require(all(type(value.get(key)) is int and value[key] >= 0 for key in keys), "Native JSON counts are missing or invalid")
+    files = []
+    for result in value["testResults"]:
+        name = result.get("name", "").replace("\\", "/")
+        matches = [test for test in NATIVE_TESTS if name == test or name.endswith("/" + test)]
+        require(len(matches) == 1 and matches[0] not in files, "Native result has an unexpected or duplicated test file")
+        files.append(matches[0])
+    require(set(files) == set(NATIVE_TESTS), "Native JSON omitted a selected test file")
+    return {"status": "PRESENT", "path": path, "sha256": sha256(local.read_bytes()), "success": value["success"], "counts": {key: value[key] for key in keys}, "reportedTestFiles": files, "note": "Exact selected-file JSON presence is verified; inspect actual assertions, skips and unhandled errors before assigning a gate result."}
 
 
