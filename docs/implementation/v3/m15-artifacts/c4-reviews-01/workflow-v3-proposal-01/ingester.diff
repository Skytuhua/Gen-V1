+def validate_native_result(args, extracted):
+    if args.kind != "native":
+        return None
+    path = "test-results/m15/native-results.json"
+    local = extracted / path
+    if not local.is_file():
+        return {"status": "INCOMPLETE", "missing": [path]}
+    value = read_json(local)
+    require(type(value.get("success")) is bool and isinstance(value.get("testResults"), list), "Native JSON result shape differs")
