+  it('orders different logical owners on the same thread and preserves the next owner failure', async () => {
+    const local = storage({macrotasks: true}), journal = await import('../apps/web/src/journal');
+    const recovery = await import('../apps/web/src/workbench-recovery');
+    const nextOwner = {...owner, workspaceId: 'copy-b'}, nextKey = recovery.sourceDraftKey(nextOwner);
+    const nextMetadata = {...metadata, logicalOwner: nextOwner, sourceRefs: [{...sourceRef, source: {...sourceRef.source, logicalOwner: nextOwner}}]};
+    const held = local.holdRead(sourceKey), first = watch(recovery.prepareSourceOwnerHandoff(owner));
+    await held.entered;
+    const failure = Error('The next logical owner has an uncommitted source operation'); local.state.failCommit = failure;
+    await expect(journal.journalCompareAndSwap(nextKey, undefined, nextMetadata)).rejects.toBe(failure);
+    const second = watch(recovery.prepareSourceOwnerHandoff(nextOwner));
+    try {
+      await turn(); expect(first.settled).toBe(false); expect(second.settled).toBe(false);
+      held.release();
+      expect(await first.result).toEqual({ok: true, value: undefined});
+      expect(await second.result).toEqual({ok: false, error: failure});
+      expect(local.rows.size).toBe(0); expect(local.staged.size).toBe(0);
+      expect(journal.journalHandoffState([nextKey])[0].failure?.cause).toBe(failure);
+    } finally {held.release(); await Promise.all([first.result, second.result]);}
+  });
