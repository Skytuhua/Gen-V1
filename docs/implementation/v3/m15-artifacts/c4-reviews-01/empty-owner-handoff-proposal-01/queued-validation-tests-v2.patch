+  it('revalidates a same-owner failure that begins after the earlier call has inspected its source', async () => {
+    const local = storage({macrotasks: true}), textBefore = local.put('draft:thread-a', 'Keep this intervening prompt');
+    const journal = await import('../apps/web/src/journal');
+    const recovery = await import('../apps/web/src/workbench-recovery');
+    const failure = Error('A new source operation failed after the earlier validation');
+    let injected = false, began!: () => void, attempted: ReturnType<typeof watch<boolean>> | undefined;
+    const begun = new Promise<void>(resolve => {began = resolve;});
+    const observe = journal.journalHandoffState; let inspections = 0;
+    const sentinel = vi.spyOn(journal, 'journalHandoffState').mockImplementation(names => {
+      if (++inspections > 64) throw Error('Queued validations did not settle after 64 metadata inspections.');
+      const states = observe(names);
+      // Queue real source work after a completed empty-read snapshot. The first
+      // validation may finish; a separately queued call must inspect the new work.
+      if (!injected && states[0].readSucceeded && !states[0].pending) {
+        injected = true;
+        queueMicrotask(() => {
+          local.state.failCommit = failure;
+          attempted = watch(journal.journalCompareAndSwap(sourceKey, undefined, metadata));
+          began();
+        });
+      }
+      return states;
+    });
+    const first = watch(recovery.prepareSourceOwnerHandoff(owner));
+    const second = watch(recovery.prepareSourceOwnerHandoff(owner));
+    try {
+      await Promise.race([begun, Promise.all([first.result, second.result])]);
+      expect(injected).toBe(true);
+      expect(await first.result).toEqual({ok: true, value: undefined});
+      expect(await attempted!.result).toEqual({ok: false, error: failure});
+      expect(await second.result).toEqual({ok: false, error: failure});
+      expect(local.rows.has(sourceKey)).toBe(false); expect(local.rows.get('draft:thread-a')).toEqual(textBefore);
+      expect(observe(keys)[0].failure?.cause).toBe(failure);
+    } finally {await Promise.all([first.result, second.result, attempted?.result]); sentinel.mockRestore();}
+  });
