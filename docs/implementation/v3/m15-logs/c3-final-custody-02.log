argv: ["python","-c","import hashlib\nimport json\nfrom pathlib import Path\nimport stat\nimport subprocess\n\nroot = Path.cwd()\noriginal = root.parent / 'gen-v1'\nparent = 'a1349b0a7ffa1420566da9c7770faf80d6be5bf3'\nbase = '49cd633273a3f61c14a4191a9877e99ab23ec88f'\n\ndef git(*args, cwd=root):\n    return subprocess.check_output(['git', *args], cwd=cwd)\n\ndef digest(data):\n    return hashlib.sha256(data).hexdigest()\n\nassert git('rev-parse', 'HEAD').decode().strip() == parent\nassert git('rev-parse', 'MERGE_HEAD').decode().strip() == base\nassert not git('ls-files', '-u')\nassert git('rev-parse', 'HEAD', cwd=original).decode().strip() == '399cde39ff4ee82272c7a7700944325c44b36070'\nassert not git('status', '--porcelain', cwd=original)\nlock = digest(Path('pnpm-lock.yaml').read_bytes())\nassert lock == '2269337714e848fd47cca88f898e6d9fd5f70e276a04061e435546ddc9eb9fb9'\nordinary_ci = digest(Path('.github/workflows/ci.yml').read_bytes())\nassert ordinary_ci == '4ac906f2a1b060b47971267bab60f0b2b66fed846f3b71f9eabafc7cdc66dca2'\n\narchives = []\nfor cut, commit, count in [('01', 'fd17d9f1b3931eb2b974b86ccc5a3892da47ba33', 16), ('02', parent, 17)]:\n    path = Path(f'docs/implementation/v3/m15-artifacts/publication-cut-{cut}/archive-manifest.json')\n    manifest = json.loads(path.read_bytes())\n    assert manifest['publishedCommit'] == commit\n    assert manifest['publishedTree'] == git('rev-parse', commit + '^{tree}').decode().strip()\n    assert len(manifest['files']) == count\n    expected_paths = sorted(name for name in git('ls-tree', '-r', '--name-only', commit, '--', 'docs/implementation/v3').decode().splitlines() if Path(name).parent.as_posix() == 'docs/implementation/v3' and Path(name).name.startswith('M15-'))\n    assert sorted(item['path'] for item in manifest['files']) == expected_paths\n    for item in manifest['files']:\n        expected_archive = path.parent / Path(item['path']).name\n        assert item['archive'] == expected_archive.as_posix()\n        assert stat.S_ISREG(expected_archive.lstat().st_mode)\n        data = expected_archive.read_bytes()\n        assert len(data) == item['bytes'] and digest(data) == item['sha256']\n        assert data == git('show', commit + ':' + item['path'])\n    archives.append({'cut': cut, 'publishedCommit': commit, 'filesVerified': count, 'manifestSha256': digest(path.read_bytes())})\n\nretained = 0\nindex = {}\nfor record in git('ls-files', '--stage', '-z', '--', 'docs/implementation/v3/m15-logs', 'docs/implementation/v3/m15-artifacts').split(b'\\0'):\n    if record:\n        metadata, name = record.split(b'\\t', 1)\n        mode, blob, stage = metadata.split()\n        assert stage == b'0'\n        index[name] = (mode, blob)\nfor record in git('ls-tree', '-r', '-z', parent, '--', 'docs/implementation/v3/m15-logs', 'docs/implementation/v3/m15-artifacts').split(b'\\0'):\n    if not record:\n        continue\n    metadata, name = record.split(b'\\t', 1)\n    mode, kind, blob = metadata.split()\n    assert kind == b'blob' and mode in (b'100644', b'100755')\n    assert index[name] == (mode, blob), name\n    current = Path(name.decode())\n    current_mode = current.lstat().st_mode\n    assert stat.S_ISREG(current_mode) and bool(current_mode & 0o111) == (mode == b'100755'), name\n    data = current.read_bytes()\n    actual = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\\0' + data).hexdigest().encode()\n    assert actual == blob, name\n    retained += 1\nassert retained == 709\n\nmanifest = json.loads(Path('scripts/public-source-files.json').read_bytes())\nassert manifest['source'] == sorted(set(manifest['source']))\nassert manifest['runtime'] == sorted(set(manifest['runtime']))\nassert set(manifest['runtime']) <= set(manifest['source'])\nchanged = set(git('diff', '--name-only', base).decode().splitlines()) | set(git('ls-files', '--others', '--exclude-standard').decode().splitlines())\nassert all(path in manifest['source'] for path in changed), sorted(changed - set(manifest['source']))\nsubprocess.run(['git', '-c', 'core.whitespace=cr-at-eol', 'diff', '--check', base, '--', '.', ':(exclude)docs/implementation/v3/m15-logs/**', ':(exclude)docs/implementation/v3/m15-artifacts/**'], check=True)\nprint(json.dumps({'originalCheckout': 'clean', 'originalHead': '399cde39ff4ee82272c7a7700944325c44b36070', 'publishedParent': parent, 'acceptedBase': base, 'unmergedPaths': 0, 'archives': archives, 'publishedEvidenceFilesUnchanged': retained, 'lockfileSha256': lock, 'ordinaryCiSha256': ordinary_ci, 'publicSourceEntries': len(manifest['source']), 'publicRuntimeEntries': len(manifest['runtime']), 'allCurrentChangesAdmitted': True, 'authoredWhitespace': 'PASS'}, indent=2))\n"]
